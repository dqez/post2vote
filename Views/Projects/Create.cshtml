@model votegdgc.Models.Project

@{
    ViewData["Title"] = "Submit Project";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h2>Submit Your Project</h2>

        <form asp-action="Create" method="post" class="mt-4">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Project Title</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prompt" class="form-label">AI Prompt Used</label>
                <textarea asp-for="Prompt" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Prompt" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ProjectLink" class="form-label">Project Link</label>
                <input asp-for="ProjectLink" type="url" class="form-control" placeholder="https://..." required />
                <span asp-validation-for="ProjectLink" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ThumbnailLink" class="form-label">Thumbnail URL (optional)</label>
                <input asp-for="ThumbnailLink" type="url" class="form-control" placeholder="https://..." />
                <span asp-validation-for="ThumbnailLink" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">Submit Project</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}