@{
    ViewData["Title"] = "Home Page";
}

<div class="flex flex-col items-center justify-center min-h-[70vh] text-center space-y-8 px-4 md:px-8">
    <div class="relative">
        <div class="absolute inset-0 bg-gdg-yellow blur-xl opacity-50 rounded-full animate-pulse"></div>
        <img src="./assets/GDSC_Icon.665f1462ba5cded266fc.png" alt="GDG Logo" class="w-32 h-32 relative z-10">
    </div>
    <h1 class="text-5xl md:text-7xl font-black tracking-tighter leading-none">
        Post<span class="text-gdg-blue">2</span>Vote
    </h1>
    <p class="text-xl md:text-2xl font-bold max-w-2xl text-gray-800">Share Your Projects. Get Votes. Build Community.</p>
    <div class="p-6 border-4 border-black bg-white shadow-[8px_8px_0px_0px_#000] max-w-lg mx-auto transform rotate-1">
        <p class="font-mono text-sm md:text-base font-bold">
            Post your amazing projects.<br>
            Let the community vote.<br>
            Celebrate the best work together.
        </p>
    </div>
    <div class="flex gap-4">
        <neo-button href="@Url.Action("Vote", "Home")" 
                   variant="primary" 
                   size="lg">
            View Gallery
        </neo-button>
        <neo-button href="@Url.Action("Create", "Projects")" 
                   variant="secondary" 
                   size="lg">
            Submit Project
        </neo-button>
    </div>
</div>