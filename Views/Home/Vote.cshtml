@model VotePageViewModel
@{
    ViewData["IsVotePage"] = true;
    ViewData["Title"] = "Vote";
}

<div class="max-w-7xl mx-auto px-4 md:px-8 py-6">
    <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
        <div class="flex items-center gap-4">
            <h1 class="text-4xl font-black uppercase italic tracking-tighter">Gallery</h1>
            @if (Model.IsAuthenticated)
            {
                <neo-badge variant="blue">@Model.VotesLeft/5 votes left</neo-badge>
            }
        </div>
    </div>

    @if (Model.Projects == null || !Model.Projects.Any())
    {
        <neo-card>
            <p class="font-bold text-xl">No projects yet. Be the first to submit!</p>
        </neo-card>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var projectCard in Model.GetProjectCards())
            {
                @await Component.InvokeAsync("ProjectCard", projectCard)
            }
        </div>
    }
</div>
