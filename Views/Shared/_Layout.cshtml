<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GDG Cloud Da Nang Devfest 2025</title>
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
</head>
<body class="bg-yellow-50 font-mono text-black selection:bg-gdg-yellow selection:text-black">
    <nav class="sticky top-0 z-40 w-full bg-white border-b-4 border-black px-4 py-3">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
            <a aria-current="page" class="flex items-center gap-2 group active" asp-controller="Home" asp-action="Index">
                <img src="../assets/GDSC_Icon.665f1462ba5cded266fc.png" alt="GDG Logo" class="w-10 h-10 border-2 border-black shadow-[2px_2px_0px_0px_#000]">
                <span class="text-xl md:text-2xl font-black tracking-tighter hidden sm:block">GDG Cloud Da Nang <span class="text-gdg-blue">Devfest</span> 2025</span>
            </a>
            <div class="hidden md:flex items-center gap-6">
                <button id="rulesBtn" class="font-bold hover:underline decoration-4 underline-offset-4 decoration-gdg-green">RULES</button>
                
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="flex items-center gap-2 font-bold px-3 py-2 border-2 border-transparent hover:border-black hover:bg-gray-100 transition-all" asp-controller="Projects" asp-action="Create">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send w-4 h-4"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
                        Submit
                    </a>
                }

                <a class="flex items-center gap-2 font-bold px-3 py-2 border-2 border-transparent hover:border-black hover:bg-gray-100 transition-all" asp-controller="Home" asp-action="Vote">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-vote w-4 h-4"><path d="m9 12 2 2 4-4"></path><path d="M5 7c0-1.1.9-2 2-2h10a2 2 0 0 1 2 2v12H5V7Z"></path><path d="M22 19H2"></path></svg>
                    Vote
                </a>
                
                <a class="flex items-center gap-2 font-bold px-3 py-2 border-2 border-transparent hover:border-black hover:bg-gray-100 transition-all" asp-controller="Home" asp-action="Leaderboard">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy w-4 h-4"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg>
                    Leaderboard
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="flex items-center gap-4">
                        <div class="flex flex-col items-end">
                            <span class="text-xs font-bold uppercase text-gray-500">Votes Left</span>
                            @{
                                var currentUser = ViewBag.CurrentUser as votegdgc.Models.User;
                                var votesLeft = currentUser?.RemainingVotes ?? 0;


                                // KIỂM TRA AVATAR:
                                // Nếu currentUser tồn tại VÀ có AvatarUrl -> Dùng AvatarUrl
                                // Ngược lại -> Dùng ảnh mặc định của bạn
                                var avatarSrc = !string.IsNullOrEmpty(currentUser?.AvatarUrl) 
                                    ? currentUser.AvatarUrl 
                                    : "../assets/GDSC_Icon.665f1462ba5cded266fc.png";
                            
                                // Lấy tên user để đưa vào thẻ alt (tốt cho SEO/Accessibility)
                                var altText = currentUser?.Name ?? "User";

                            }
                            <span class="text-lg font-black leading-none text-gdg-red">@votesLeft</span>
                        </div>
                        <div class="h-8 w-[2px] bg-black"></div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="flex items-center gap-2 font-bold hover:text-gdg-red">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-log-out w-5 h-5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" x2="9" y1="12" y2="12"></line></svg>
                            </button>
                        </form>
                        <img src="@avatarSrc" 
                             alt="@altText" 
                             class="w-10 h-10 object-cover rounded-none border-2 border-black shadow-[2px_2px_0px_0px_#000]">
                    </div>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="flex items-center gap-2 font-bold px-3 py-2 border-2 border-black bg-gdg-blue text-white shadow-neo hover:-translate-y-0.5 hover:shadow-[6px_6px_0px_0px_#000] transition-all">
                        Login with Google
                    </a>
                }
            </div>
            <button class="md:hidden p-2 border-2 border-black active:bg-gray-200">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu "><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
            </button>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["Success"] != null)
        {
            <div class="p-4 mb-4 text-sm text-green-800 rounded-lg bg-green-50 dark:bg-gray-800 dark:text-green-400" role="alert">
                @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
                @TempData["Error"]
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Rules Modal -->
    <div id="rulesModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Backdrop -->
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm transition-opacity"></div>
        
        <!-- Modal Container -->
        <div class="absolute inset-0 z-10 w-screen overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0"  style="margin-top: 200px; width: 600px;">
                <div class="relative transform overflow-hidden bg-white text-left shadow-[8px_8px_0px_0px_#000] border-4 border-black p-8 max-w-md w-full mx-4 transition-all">
                    <h2 class="text-3xl font-black mb-6 uppercase tracking-tighter">Event Rules</h2>
                    <ul class="space-y-4 font-bold list-disc pl-5 mb-8">
                        <li>Each user gets 5 VOTES.</li>
                        <li>You cannot vote for the same project twice.</li>
                        <li>Projects must be Vibe Coding submissions using Gemini.</li>
                        <li>Include your Google AI Studio link.</li>
                        <li>Have fun and keep the vibe high!</li>
                    </ul>
                    <button id="closeRulesBtn" class="w-full bg-gdg-yellow border-2 border-black px-6 py-3 font-black uppercase tracking-wider shadow-[4px_4px_0px_0px_#000] hover:translate-y-1 hover:shadow-none transition-all">
                        Got it!
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rulesBtn = document.getElementById('rulesBtn');
            const rulesModal = document.getElementById('rulesModal');
            const closeRulesBtn = document.getElementById('closeRulesBtn');

            if (rulesBtn && rulesModal && closeRulesBtn) {
                rulesBtn.addEventListener('click', () => {
                    rulesModal.classList.remove('hidden');
                });

                closeRulesBtn.addEventListener('click', () => {
                    rulesModal.classList.add('hidden');
                });

                rulesModal.addEventListener('click', (e) => {
                    if (e.target === rulesModal) {
                        rulesModal.classList.add('hidden');
                    }
                });
            }
        });
    </script>
</body>
</html>